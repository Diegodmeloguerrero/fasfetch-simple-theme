{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "none",
    "padding": {
      "top": 1
    }
  },
  "display": {
    "separator": " ",
    "color": {
      "keys": "#777777",
      "output": "#777777"
    },
    "key": {
      "width": 11
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "\u001b[38;5;235m────────────────────────────────────────────────────────\u001b[0m"
    },
    { "type": "os", "key": "os", "format": "{3}" },
    { "type": "kernel", "key": "kernel" },
    { "type": "disk", "key": "age", "folders": "/", "format": "{days} days" },
    { "type": "uptime", "key": "uptime" },
    { "type": "packages", "key": "packages" },
    { "type": "shell", "key": "shell" },
    { "type": "wm", "key": "wm" },
    { "type": "terminal", "key": "terminal" },
    { "type": "cpu", "key": "cpu", "format": "{1}" },
    { "type": "gpu", "key": "gpu", "format": "{name} [{type}]" },
    { "type": "memory", "key": "memory" },
    { "type": "disk", "key": "disk"},
    {
      "type": "custom",
      "format": "\u001b[38;5;235m────────────────────────────────────────────────────────\u001b[0m"
    },
    {
      "type": "command",
      "shell": "bash",
      "key": "",
      "text": "shuf -n 1 \"$HOME/.config/fastfetch/phrases.txt\""
    }
  ]
}
